lookcs 49 {id:B}{id:D} wait=3
lookexpect task(40:seize(P)) task(40) task(111:image(B,26118)) task(40:seize(D))
expectdb "SELECT HEX(SUBSTRING(i.details,1,4)) FROM items i JOIN item_containers ic ON ic.container_id=i.container_id JOIN characters c ON c.id=ic.owner_id WHERE c.name='${n3}' AND i.template_id=26060" 06660000 8
item 29704 3 as C
lookcs 52 {u32:23457} 02 SELF {id:C}{tpl:C}{grade:C}{unit:C} 03 SELF {id:B}{tpl:B}{grade:B} 00 wait=10 until=ended
lookexpect started(23457,3000,echo)@80-800 fired(23457,echo)@3080-4500 task(111:image(B,0)) task(111:count(C,-1)) task(40:count(C,-1)) ended
lookgap send started 80 800
lookgap started fired 3000 3500
lookgap fired ended 0 250
expectdb "SELECT HEX(SUBSTRING(i.details,1,4)) FROM items i JOIN item_containers ic ON ic.container_id=i.container_id JOIN characters c ON c.id=ic.owner_id WHERE c.name='${n3}' AND i.template_id=26060" 00000000 8
expectdb "SELECT COALESCE(SUM(i.count),0) FROM items i JOIN item_containers ic ON ic.container_id=i.container_id JOIN characters c ON c.id=ic.owner_id WHERE c.name='${n3}' AND i.template_id=29704" 1 8
pump 1
