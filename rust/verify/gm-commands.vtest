# GM command audit: every registered command with a typical valid call and one invalid call.
# The `gm` script command sends "/<text>" as a GM chat command and prints the replies; the
# server log carries the error lines. Docs/wiki/GM-Commands.md is the tester guide derived from
# this suite. Run: Scripts/verify.sh --only gm-commands
#
# The bot must be a GM (access level 100): Scripts/verify.sh provisions the `gm` bot accounts.
# Commands that need an object id created at run time (doodad phases, item expiry, ...) are
# covered with an invalid id here and with unit tests in the command modules.
suite GM command audit
bot gm gm

[gm]
# --- help and echo -------------------------------------------------------------------------
gm help
gm help gold
gm echo hello audit
gm help no_such_command

# --- items and money ----------------------------------------------------------------------
gm gold add self 1 2 3
gm gold add self notanumber
gm gold remove self 0 0 1
gm gold set self 0
gm item add self 23633 2
gm item add self 23633
gm item add self notanumber
gm item add nobody 23633
gm item add self 23633 1 9
gm item add self 23633 1 12
gm item expire 999999999
gm item expire abc
gm item unwrap 999999999
gm item unwrap abc
gm kit
gm kit consumables
gm kit no_such_kit
gm kit self no_such_kit
gm labor 10
gm labor -5
gm labor abc
gm xp 100
gm xp abc
gm vocation 10
gm vocation abc
gm premium self off
gm premium self on 1
gm premium nobody on

